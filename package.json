{
  "name": "cascade-workspace",
  "workspaces": [
    "tools/*",
    "packages/**"
  ],
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --oxlint --no-typescript",
    "lint": "cd packages && oxlint",
    "fix": "cd packages && bun lint -- --fix",
    "fmt": "oxfmt . '!tools/**/*.*/**/*'",
    "test": "cd packages && vitest run",
    "build": "pnpm --filter './packages/*' exec bun vite build",
    "docs": "pnpm --filter './packages/*' exec bun docgen"
  },
  "dependencies": {
    "effect": "^4.0.0-rc"
  },
  "devDependencies": {
    "@effect/docgen": "^4.0.0-rc",
    "@effect/tsgo": "^0.38.0",
    "@effect/vitest": "^4.0.0-rc",
    "@types/bun": "latest",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "type-fest": "^5.9.0",
    "typescript": "^7",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
