{
  "name": "cascade-workspace",
  "private": "true",
  "workspaces": [
    "tools/oxlint",
    "packages/**"
  ],
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "build": "bun build:core && bun build:react",
    "build:core": "cd packages/core && vite build",
    "build:react": "cd packages/react && vite build",
    "test": "cd packages && vitest run",
    "lint": "oxlint --ignore-pattern \"tools/**\"",
    "fix": "oxlint --ignore-pattern \"tools/**\" --fix",
    "fmt": "oxfmt",
    "prepare": "effect-tsgo patch --oxlint --no-typescript"
  },
  "dependencies": {
    "@effect/platform-bun": "^4.0.0-rc",
    "effect": "^4.0.0-rc"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.38.0",
    "@effect/vitest": "^4.0.0-rc",
    "@types/bun": "latest",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
